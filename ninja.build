build _artifacts/phase1-350m-differential/result.json: metal_runtime_differential _build/bin/llmopt-fx _build/native/metal-runtime.stamp _build/q8-fx-example/kernel.metallib python/examples/metal_runtime_differential.py python/llmopt_backend/__init__.py python/llmopt_backend/metal_runtime.py python/llmopt_backend/quantization.py
build metal-runtime-differential: phony _artifacts/phase1-350m-differential/result.json

build all: phony _build/bin/llmopt-demo _build/bin/llmopt-test _build/bin/llmopt-fx
build ocaml-test: run_test _build/bin/llmopt-test
build python-test: python_test
build test: phony ocaml-test python-test
build demo: run_demo _build/bin/llmopt-demo
build metal: metal_compile | demo
build q8-metal: q8_metal_check | demo
build q8-llvm: q8_llvm_check | demo
build q8-smoke: phony q8-metal q8-llvm
build fx-smoke: phony _build/fx-example/kernel.ll.o _build/fx-example/kernel.air
build bench-mps: lfm25_mps_benchmark | _build/bin/llmopt-fx _build/native/metal-runtime.stamp bench/lfm25_mps.py python/llmopt_backend/__init__.py python/llmopt_backend/metal_runtime.py python/llmopt_backend/quantization.py
