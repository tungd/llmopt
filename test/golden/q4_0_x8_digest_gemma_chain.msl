    if (base_col + 5u < params.n) output[base_col + 5u] = half(((((accumulator5 * (1.0f / (1.0f + metal::exp(-accumulator5)))) + ((float)buf_0[(base_col + 5u)])) + ((float)buf_1[(base_col + 5u)])) * ((float)buf_2[(base_col + 5u)])));
    if (base_col + 6u < params.n) output[base_col + 6u] = half(((((accumulator6 * (1.0f / (1.0f + metal::exp(-accumulator6)))) + ((float)buf_0[(base_col + 6u)])) + ((float)buf_1[(base_col + 6u)])) * ((float)buf_2[(base_col + 6u)])));
    if (base_col + 7u < params.n) output[base_col + 7u] = half(((((accumulator7 * (1.0f / (1.0f + metal::exp(-accumulator7)))) + ((float)buf_0[(base_col + 7u)])) + ((float)buf_1[(base_col + 7u)])) * ((float)buf_2[(base_col + 7u)])));
