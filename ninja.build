ocaml_flags = -O3 -g -bin-annot -I _build/ocaml
ocaml_packages = -package yojson,unix

rule ocaml_interface
  command = mkdir -p _build/ocaml && ocamlfind ocamlopt $ocaml_packages $ocaml_flags -c $in -o $out
  description = ocaml interface $in

rule ocaml_module
  command = mkdir -p _build/ocaml && ocamlfind ocamlopt $ocaml_packages $ocaml_flags -c $in -o $out
  description = ocaml module $in

rule ocaml_link
  command = mkdir -p _build/bin && ocamlfind ocamlopt $ocaml_packages -linkpkg $in -o $out
  description = link $out

rule run_demo
  command = $in --emit-dir _build/llmopt-demo
  description = emit capture, LLVM IR, and Metal sources
  pool = console

rule run_test
  command = $in
  description = run OCaml tests
  pool = console

rule metal_compile
  command = xcrun metal -c _build/llmopt-demo/small.metal -o _build/llmopt-demo/small.air
  description = compile Metal kernel
  pool = console

rule python_test
  command = PYTHONPATH=python:bench python3.13 -m unittest discover -s python/tests -v
  description = run Python FX and benchsuite tests
  pool = console

rule fx_manifest
  command = mkdir -p _build/fx-example && _build/bin/llmopt-fx python/examples/linear_fx.json _build/fx-example
  description = plan the static FX fixture
  pool = console

rule q8_fx_manifest
  command = mkdir -p _build/q8-fx-example && _build/bin/llmopt-fx python/examples/q8_linear_fx.json _build/q8-fx-example
  description = plan the static Q8 FX fixture
  pool = console

rule llvm_check
  command = clang -c -x ir $in -o $out
  description = validate emitted LLVM IR
  pool = console

rule metal_check
  command = xcrun metal -c $in -o $out
  description = validate emitted Metal source

rule q8_metal_check
  command = xcrun metal -c _build/llmopt-demo/lfm25_linear.metal -o _build/llmopt-demo/lfm25_linear.air
  description = validate emitted Q8 Metal source

rule q8_llvm_check
  command = clang -c -x ir _build/llmopt-demo/lfm25_linear.ll -o _build/llmopt-demo/lfm25_linear.ll.o
  description = validate emitted Q8 LLVM IR
  pool = console

rule metal_lib
  command = xcrun metallib $in -o $out
  description = link Metal library $out
  pool = console

rule native_runtime
  command = python3.13 native/build_metal_runtime.py --build-dir _build/native --stamp $out
  description = build PyTorch MPS runtime bridge
  pool = console

rule metal_runtime_smoke
  command = PYTHONPATH=python python3.13 python/examples/metal_runtime_smoke.py --library _build/q8-fx-example/kernel.metallib
  description = dispatch tiled Q8 Metal runtime smoke
  pool = console

rule metal_runtime_model_smoke
  command = mkdir -p _artifacts/phase1-350m-mps && LLMOPT_METAL_RUNTIME=exact PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.8 PYTORCH_MPS_LOW_WATERMARK_RATIO=0.7 PYTHONPATH=python:bench python3.13 bench/lfm25_mps.py --model LiquidAI/LFM2.5-350M --quantization q8 --iterations 1 --warmup 0 --artifact-dir _artifacts/phase1-350m-mps/graphs --output _artifacts/phase1-350m-mps/result.json
  description = run 350M generated Metal Q8 FX integration smoke
  pool = console

rule metal_runtime_differential
  command = mkdir -p _artifacts/phase1-350m-differential && PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.8 PYTORCH_MPS_LOW_WATERMARK_RATIO=0.7 PYTHONPATH=python:bench python3.13 python/examples/metal_runtime_differential.py --library _build/q8-fx-example/kernel.metallib --model LiquidAI/LFM2.5-350M --artifact-dir _artifacts/phase1-350m-differential/graphs --output _artifacts/phase1-350m-differential/result.json
  description = run one 350M generated Q8 differential probe
  pool = console

rule lfm25_mps_benchmark
  command = mkdir -p _artifacts/lfm25-mps && python3.13 bench/lfm25_mps.py --artifact-dir _artifacts/lfm25-mps/graphs --output _artifacts/lfm25-mps/result.json
  description = benchmark LFM2.5 PyTorch MPS execution
  pool = console

rule lfm25_benchsuite
  command = mkdir -p _artifacts/lfm25-benchsuite-q8-racebench-safe && PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.8 PYTORCH_MPS_LOW_WATERMARK_RATIO=0.7 PYTHONPATH=python:bench python3.13 bench/lfm25_benchsuite.py --model LiquidAI/LFM2.5-350M --profile semantic-5x3 --require-shape-matched-warmup --release-mps-cache --isolate --needle-lengths 2048,4096 --needle-positions 10,50,90 --artifact-dir _artifacts/lfm25-benchsuite-q8-racebench-safe --output _artifacts/lfm25-benchsuite-q8-racebench-safe/result.json --record-output bench/results/lfm25-350m-q8-racebench-baseline.json
  description = run racebench-shaped ERS trace and needle benchsuite on LFM2.5-350M MPS
  pool = console

rule lfm25_benchsuite_350m
  command = mkdir -p _artifacts/lfm25-benchsuite-350m-q8-racebench-safe && PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.8 PYTORCH_MPS_LOW_WATERMARK_RATIO=0.7 PYTHONPATH=python:bench python3.13 bench/lfm25_benchsuite.py --model LiquidAI/LFM2.5-350M --profile semantic-5x3 --require-shape-matched-warmup --release-mps-cache --isolate --needle-lengths 2048,4096 --needle-positions 10,50,90 --artifact-dir _artifacts/lfm25-benchsuite-350m-q8-racebench-safe --output _artifacts/lfm25-benchsuite-350m-q8-racebench-safe/result.json --record-output bench/results/lfm25-350m-q8-racebench-baseline.json
  description = run racebench-shaped ERS trace and needle benchsuite on LFM2.5-350M MPS
  pool = console

rule lfm25_benchsuite_smoke
  command = mkdir -p _artifacts/lfm25-benchsuite-smoke && PYTHONPATH=python:bench python3.13 bench/lfm25_benchsuite.py --trace bench/traces/lfm25-mps-smoke.json --warmup-trace bench/traces/lfm25-mps-warmup.json --needle-lengths 128,256 --needle-positions 10,50,90 --artifact-dir _artifacts/lfm25-benchsuite-smoke --output _artifacts/lfm25-benchsuite-smoke/result.json
  description = run short ERS engine smoke on MPS
  pool = console

build _build/ocaml/shape.cmi: ocaml_interface lib/shape.mli
build _build/ocaml/shape.cmx: ocaml_module lib/shape.ml | _build/ocaml/shape.cmi

build _build/ocaml/ir.cmi: ocaml_interface lib/ir.mli | _build/ocaml/shape.cmi
build _build/ocaml/ir.cmx: ocaml_module lib/ir.ml | _build/ocaml/ir.cmi _build/ocaml/shape.cmx

build _build/ocaml/tile_effect.cmi: ocaml_interface lib/tile_effect.mli | _build/ocaml/shape.cmi _build/ocaml/ir.cmi
build _build/ocaml/tile_effect.cmx: ocaml_module lib/tile_effect.ml | _build/ocaml/tile_effect.cmi _build/ocaml/shape.cmx _build/ocaml/ir.cmx

